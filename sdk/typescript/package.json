{
  "name": "@agent-middleware/verify",
  "version": "0.1.0",
  "private": true,
  "description": "Offline verifier for Agent Middleware signed receipts (Ed25519, no network).",
  "type": "module",
  "main": "./dist/verify.js",
  "types": "./dist/verify.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "prepublishOnly": "npm run build && npm test",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.4"
  },
  "license": "Apache-2.0"
}
